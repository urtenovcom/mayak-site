# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-stale-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
.codex-dev.*.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Локальные доступы (пароли не должны попадать в историю репозитория)
docs/*.local.md

# Журнал заявок (персональные данные)
/leads.jsonl

# Админка — отдельный репозиторий со своей историей, см. docs/DEPLOY.md
/react-project-admin-back/
